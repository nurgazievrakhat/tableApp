{
  "name": "table-easy-app",
  "version": "0.2.0",
  "private": true,
  "description": "Поиск товаров и сравнение цен по прайс-листам поставщиков",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dist:win": "vite build && electron-builder --win nsis --publish never",
    "postinstall": "electron-builder install-app-deps",
    "check:parser": "node --no-warnings scripts/check-parser.mts",
    "release:win": "vite build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "kg.tableeasy.app",
    "productName": "TableEasy",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "TableEasy-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nurgazievrakhat",
        "repo": "tableApp",
        "releaseType": "release"
      }
    ]
  },
  "author": "nurgazievrakhat",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/nurgazievrakhat/tableApp.git"
  }
}
